{
  "name": "dsh-desk-kit",
  "version": "1.20.0",
  "description": "定时提醒、随手便签(可带截图/文件)、网页收藏格子、加密保险库,四块都在侧栏标签页里;全局搜索 + 定时清理,另有 27 个 Agent 工具",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "tool.js",
    "capture.js",
    "lunar.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "src",
    "test"
  ],
  "keywords": [
    "agent-tools",
    "bookmarks",
    "checkin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "links",
    "notes",
    "reminder",
    "sidebar",
    "vault",
    "attachments",
    "screenshot",
    "files",
    "search",
    "cleanup"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": ">=20.18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tera-Dark/dsh-desk-kit.git"
  },
  "homepage": "https://github.com/Tera-Dark/dsh-desk-kit#readme",
  "bugs": {
    "url": "https://github.com/Tera-Dark/dsh-desk-kit/issues"
  },
  "author": "Tera-Dark",
  "scripts": {
    "test": "node --check index.js && node --check client.js && node test.mjs && node capture.test.mjs && node lunar.test.mjs && node client-test.mjs && node ownership.test.mjs && node ai-classify.test.mjs && node entry.test.mjs",
    "test:host": "node harness.mjs",
    "test:installed": "node verify-installed.mjs",
    "test:all": "npm test && npm run test:host && npm run test:installed",
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "pretest": "node scripts/build-client.mjs --check",
    "test:ui": "node test/ui.e2e.mjs --auto"
  }
}
